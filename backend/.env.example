# Document local backend environment variables; replace example credentials in your private .env file.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/shiftly
# Vercel's Neon integration sets DATABASE_URL automatically. Do not use a local SQLite URL on Vercel.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_SEED_DATABASE=false
